{
  "meta": {
    "name": "Kinetic Grid Portfolio Tokens",
    "version": "1.0.0",
    "description": "Design tokens companion to Design.md. Swap 'accent' hue to re-skin the whole system."
  },
  "color": {
    "dark": {
      "bg.canvas": "#0A0A0C",
      "bg.surface": "#131316",
      "bg.surfaceRaised": "#1B1B1F",
      "border.subtle": "#2A2A2F",
      "text.primary": "#F5F5F7",
      "text.secondary": "#A1A1AA",
      "text.tertiary": "#6B6B72",
      "accent": "#C6FF3D",
      "accent.contrastText": "#0A0A0C",
      "accent.muted": "rgba(198,255,61,0.12)",
      "success": "#3DDC84",
      "danger": "#FF5C5C"
    },
    "light": {
      "bg.canvas": "#FAFAF9",
      "bg.surface": "#FFFFFF",
      "bg.surfaceRaised": "#F1F1F0",
      "border.subtle": "#E5E5E5",
      "text.primary": "#111113",
      "text.secondary": "#5B5B62",
      "text.tertiary": "#8A8A90",
      "accent": "#5B8A00",
      "accent.contrastText": "#FFFFFF",
      "accent.muted": "rgba(91,138,0,0.10)",
      "success": "#1F8F4E",
      "danger": "#D93636"
    }
  },
  "typography": {
    "fontFamily": {
      "display": "'Clash Display', 'Inter Tight', system-ui, sans-serif",
      "body": "'Inter', system-ui, sans-serif",
      "mono": "'JetBrains Mono', ui-monospace, SFMono-Regular, monospace"
    },
    "scale": {
      "display.xl": { "desktop": "96px", "mobile": "40px", "weight": 700, "lineHeight": 1.02, "letterSpacing": "-0.02em" },
      "display.lg": { "desktop": "64px", "mobile": "32px", "weight": 600, "lineHeight": 1.05, "letterSpacing": "-0.02em" },
      "display.md": { "desktop": "40px", "mobile": "26px", "weight": 600, "lineHeight": 1.1, "letterSpacing": "-0.01em" },
      "body.lg": { "desktop": "20px", "mobile": "17px", "weight": 500, "lineHeight": 1.5 },
      "body.md": { "desktop": "16px", "mobile": "15px", "weight": 400, "lineHeight": 1.6 },
      "body.sm": { "desktop": "14px", "mobile": "13px", "weight": 400, "lineHeight": 1.5 },
      "mono.label": { "desktop": "13px", "mobile": "12px", "weight": 500, "lineHeight": 1.4, "letterSpacing": "0.04em", "textTransform": "uppercase" },
      "mono.micro": { "desktop": "11px", "mobile": "11px", "weight": 500, "lineHeight": 1.3, "letterSpacing": "0.06em" }
    }
  },
  "space": {
    "unit": "8px",
    "sectionPadding": { "mobile": "96px", "tablet": "128px", "desktop": "160px" },
    "grid": { "columns": 12, "gutter": "24px", "maxWidth": "1280px", "outerMargin": "clamp(20px, 5vw, 96px)" }
  },
  "radius": {
    "sm": "6px",
    "md": "10px",
    "lg": "16px",
    "xl": "20px",
    "pill": "999px"
  },
  "motion": {
    "duration": { "fast": "120ms", "base": "200ms", "slow": "400ms", "marqueeLoop": "24-40s" },
    "easing": { "entrance": "cubic-bezier(0.22, 1, 0.36, 1)", "hover": "ease-out" },
    "reducedMotion": "collapse transforms to opacity-only or instant; freeze marquees"
  },
  "breakpoints": {
    "xs": "0px",
    "sm": "480px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px"
  },
  "elevation": {
    "card": "0 1px 2px rgba(0,0,0,0.4)",
    "cardHover": "0 12px 24px rgba(0,0,0,0.35)",
    "modal": "0 24px 48px rgba(0,0,0,0.5)"
  }
}
